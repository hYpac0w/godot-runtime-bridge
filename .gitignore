# Godot 4+ specific ignores
.godot/

# Import metadata generated by whichever project consumes this addon. The paths inside
# are relative to that project (res://vendor/godot-runtime-bridge/media/... rather than
# res://media/...), so a committed .import file would be wrong for every other consumer.
*.import

# Node.js
node_modules/

# Temporary override.cfg written by MCP server during test launches
override.cfg

# Mission runner output
missions/reports/

# MCP verification output
mcp/reports/

# Internal Pro feature notes — not part of the shipped repo
addons/godot-runtime-bridge/GRB_PRO.md
